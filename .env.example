# Database
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/evacuation_db

# Security & JWT
JWT_SECRET=super-secret-marl-evacuation-key-2026-secure-token
JWT_REFRESH_SECRET=super-secret-refresh-marl-key-2026-secure-token

# SUMO Simulation
SUMO_HOME=
SUMO_BINARY=sumo

# Model Settings (Production: Offline-to-Online MARL)
MODEL_CHECKPOINT=models/marl_six/offline_online/seed_42/best_model.pt
MODEL_DEVICE=cuda

# Road Network
OSM_GRAPH_PATH=data/processed/road_graph_large.json
DATA_PATH=data/processed

# System & Logging
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=*

# Mobile Client API URL
# For Android Emulator use: http://10.0.2.2:8000
# For Physical Device on LAN use: http://<YOUR_LAN_IP>:8000
# For Web Browser testing: http://localhost:8000
MOBILE_API_URL=http://localhost:8000
